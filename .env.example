# Jarvis - Ortam değişkenleri (örnek)
# Bu dosyayı .env olarak kopyalayın ve gerçek değerleri girin.

# --- Yapay Zeka (OpenAI uyumlu /chat/completions) ---
# Jarvis, AI uç noktası tanımlı değilse bile skill'lerle çalışır.
AI_API_URL=
AI_MODEL=jarvis-chat
AI_API_KEY=
# Alternatif uyumlu değişkenler:
# AI_URL=
# MODEL=

# AI sağlayıcı seçimi (şimdilik yalnız "jarvis")
AI_PROVIDER=jarvis

# --- REST API sunucusu ---
JARVIS_PORT=3000
# İsteğe bağlı API anahtarı (boş bırakılırsa koruma kapalıdır)
JARVIS_API_KEY=

# --- Hata ayıklama ---
DEBUG=false
