# Jarvis v10 — Tamamen Yerel, Dış API Yok
# API anahtarı, URL veya dış servis gerekmez.

# Jarvis'in model adı (yerel, yalnızca etiket amaçlı)
AI_MODEL=jarvis-local

# İstek zaman aşımı (ms, yerel olduğu için genelde kullanılmaz)
AI_TIMEOUT=60000

# Hata ayıklama loglarını aç (karar motoru çıktısını gösterir)
DEBUG=false

# Servislerin otomatik başlatılmasını kapat (yerel servisler yoksa)
AUTO_START_SERVICES=false
